@page "/property/edit/{id}"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject PropertyService PropertyService
@inject UserStateService UserState
@inject IWebHostEnvironment Environment

<PageTitle>HomeNest - Редактирай имот</PageTitle>

<div class="publish-page">
    <div class="section-container">
        @if (_loading)
        {
            <div style="text-align: center; padding: 48px;">
                <div class="filter-spinner" style="margin: 0 auto;"></div>
                <p style="margin-top: 16px; color: var(--color-text-light);">Зареждане...</p>
            </div>
        }
        else if (_unauthorized)
        {
            <div class="publish-card-modern" style="text-align: center; padding: 48px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="1.5" style="margin-bottom: 16px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <h3>Нямате достъп</h3>
                <p style="color: var(--color-text-light); margin-top: 8px;">Можете да редактирате само собствените си обяви.</p>
                <a href="/my-listings" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Към моите обяви</a>
            </div>
        }
        else if (_property == null)
        {
            <div class="publish-card-modern" style="text-align: center; padding: 48px;">
                <h3>Имотът не е намерен</h3>
                <p style="color: var(--color-text-light); margin-top: 8px;">Имотът, който търсите, не съществува или е премахнат.</p>
                <a href="/my-listings" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Към моите обяви</a>
            </div>
        }
        else if (_submitted)
        {
            <div style="text-align: center; padding: 64px 24px;">
                <div style="width: 80px; height: 80px; margin: 0 auto 24px; background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#155724" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <h3 style="color: #155724; font-weight: 700; font-size: 22px; margin-bottom: 8px;">Имотът е актуализиран успешно!</h3>
                <p style="color: var(--color-text-light); margin-bottom: 24px;">Промените са запазени.</p>
                <div style="display: flex; gap: 12px; justify-content: center;">
                    <a href="/my-listings" class="btn-secondary" style="display: inline-flex;">Към моите обяви</a>
                    <a href="/property/@_property.Id" class="btn-primary" style="display: inline-flex;">Виж имота</a>
                </div>
            </div>
        }
        else
        {
            <div class="publish-hero">
                <h1>Редактирай имот</h1>
                <p>Актуализирайте детайлите за вашия имот.</p>
            </div>

            <div class="publish-card-modern">
                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Основна информация
                </div>

                <div class="form-group-modern">
                    <label>Заглавие *</label>
                    <input type="text" @bind="_title" placeholder="Напр. Просторен тристаен апартамент" />
                </div>

                <div class="form-group-modern">
                    <label>Описание *</label>
                    <textarea @bind="_description" rows="4" placeholder="Опишете имота..." />
                </div>

                <div class="form-row">
                    <div class="form-group-modern">
                        <label>Район *</label>
                        <select @bind="_district">
                            @foreach (var district in _districts)
                            {
                                <option value="@district">@district</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-modern">
                        <label>Вид на имота *</label>
                        <select @bind="_type">
                            @foreach (var type in _propertyTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="publish-divider"></div>

                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    Детайли
                </div>

                <div class="form-row-3">
                    <div class="form-group-modern">
                        <label>Цена (€) *</label>
                        <input type="number" @bind="_price" placeholder="Напр. 550" />
                    </div>
                    <div class="form-group-modern">
                        <label>Площ (кв.м) *</label>
                        <input type="number" @bind="_area" placeholder="Напр. 80" />
                    </div>
                    <div class="form-group-modern">
                        <label>Брой стаи *</label>
                        <input type="number" @bind="_rooms" placeholder="Напр. 3" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group-modern">
                        <label>Етаж *</label>
                        <input type="number" @bind="_floor" placeholder="Напр. 3" />
                    </div>
                    <div class="form-group-modern" style="justify-content: flex-end;">
                        <label style="visibility: hidden;">Обзаведен</label>
                        <label class="checkbox-modern">
                            <input type="checkbox" @bind="_furnished" />
                            <span>Обзаведен имот</span>
                        </label>
                    </div>
                </div>

                <div class="publish-divider"></div>

                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Снимка на имота
                </div>

                <div class="image-upload-modern @(!string.IsNullOrEmpty(_imagePreview) ? "has-image" : "")">
                    @if (!string.IsNullOrEmpty(_imagePreview))
                    {
                        <div class="image-upload-preview-modern">
                            <img src="@_imagePreview" alt="Preview" />
                            <button type="button" class="image-upload-remove-modern" @onclick="RemoveImage" title="Премахни снимката">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        <InputFile OnChange="LoadFiles" accept="image/*" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B5B0A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p style="font-size: 15px; font-weight: 500; color: var(--color-text); margin-bottom: 4px;">Качи снимка</p>
                        <p style="font-size: 13px; color: var(--color-text-light);">Плъзни или кликни тук. Макс. 5 MB</p>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <span class="image-upload-error">@_uploadError</span>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="auth-error" style="margin-top: 16px;">@_error</div>
                }

                <div class="publish-actions-modern">
                    <button class="btn-secondary" @onclick='() => Navigation.NavigateTo("/my-listings")'>Отказ</button>
                    <button class="btn-primary" @onclick="HandleSave">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Запази промените
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Property? _property;
    private bool _loading = true;
    private bool _unauthorized = false;
    private string _title = "";
    private string _description = "";
    private string _district = "Приморски";
    private string _type = "3-стаен";
    private int _price = 0;
    private int _area = 0;
    private int _rooms = 1;
    private int _floor = 1;
    private bool _furnished = false;
    private string _error = "";
    private string _uploadError = "";
    private bool _submitted = false;
    private string _imagePath = "";
    private string _imagePreview = "";
    private string _originalImagePath = "";

    private List<string> _districts = new();
    private List<string> _propertyTypes = new();

    protected override async Task OnInitializedAsync()
    {
        _districts = PropertyService.GetDistricts().Where(d => d != "Всички").ToList();
        _propertyTypes = PropertyService.GetPropertyTypes().Where(t => t != "Всички").ToList();

        if (!UserState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
            return;
        }

        if (int.TryParse(Id, out var id))
        {
            _property = await PropertyService.GetPropertyByIdAsync(id);
            if (_property == null)
            {
                _loading = false;
                return;
            }

            if (_property.OwnerId != UserState.UserId && !UserState.IsAdmin)
            {
                _unauthorized = true;
                _loading = false;
                return;
            }

            _title = _property.Title;
            _description = _property.Description;
            _district = _property.District;
            _type = _property.Type;
            _price = _property.Price;
            _area = _property.Area;
            _rooms = _property.Rooms;
            _floor = _property.Floor;
            _furnished = _property.Furnished;
            _imagePath = _property.Image;
            _originalImagePath = _property.Image;
            _imagePreview = _property.Image;
        }
        _loading = false;
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        _uploadError = "";
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            _uploadError = "Снимката трябва да е по-малка от 5 MB.";
            return;
        }

        var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads");
        if (!Directory.Exists(uploadsFolder))
        {
            Directory.CreateDirectory(uploadsFolder);
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" };
        if (!allowedExtensions.Contains(extension))
        {
            _uploadError = "Разрешени формати: JPG, PNG, WEBP, GIF.";
            return;
        }

        var trustedFileName = $"{Guid.NewGuid()}{extension}";
        var filePath = Path.Combine(uploadsFolder, trustedFileName);

        try
        {
            await using var fs = new FileStream(filePath, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(fs);

            if (!string.IsNullOrEmpty(_imagePath) && _imagePath.StartsWith("uploads/") && _imagePath != _originalImagePath)
            {
                var oldPath = Path.Combine(Environment.WebRootPath, _imagePath);
                try { if (File.Exists(oldPath)) File.Delete(oldPath); } catch { }
            }

            _imagePath = $"uploads/{trustedFileName}";
            _imagePreview = _imagePath;
        }
        catch
        {
            _uploadError = "Грешка при качване на снимката. Опитайте отново.";
        }
    }

    private void RemoveImage()
    {
        if (!string.IsNullOrEmpty(_imagePath) && _imagePath.StartsWith("uploads/"))
        {
            var fullPath = Path.Combine(Environment.WebRootPath, _imagePath);
            try { if (File.Exists(fullPath)) File.Delete(fullPath); } catch { }
        }
        _imagePath = "";
        _imagePreview = "";
        _uploadError = "";
    }

    private async Task HandleSave()
    {
        _error = "";
        if (_property == null) return;

        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_description) || _price <= 0 || _area <= 0)
        {
            _error = "Моля, попълнете всички задължителни полета коректно.";
            return;
        }

        if (_originalImagePath != _imagePath && _originalImagePath.StartsWith("uploads/"))
        {
            var oldPath = Path.Combine(Environment.WebRootPath, _originalImagePath);
            try { if (File.Exists(oldPath)) File.Delete(oldPath); } catch { }
        }

        _property.Title = _title;
        _property.Description = _description;
        _property.Price = _price;
        _property.Area = _area;
        _property.Rooms = _rooms;
        _property.District = _district;
        _property.Type = _type;
        _property.Furnished = _furnished;
        _property.Floor = _floor;
        _property.Image = string.IsNullOrEmpty(_imagePath) ? "images/property-1.jpg" : _imagePath;
        _property.PriceUnit = "/ месец";
        _property.FeaturesList = new() { $"{_rooms} стаен", _furnished ? "Обзаведен" : "Необзаведен", $"{_area} кв.м" };

        var ownerId = UserState.IsAdmin ? (int?)null : UserState.UserId;
        var success = await PropertyService.UpdatePropertyAsync(_property, ownerId);
        if (success)
        {
            _submitted = true;
        }
        else
        {
            _error = "Грешка при запазване. Проверете дали имате права да редактирате този имот.";
        }
    }
}
