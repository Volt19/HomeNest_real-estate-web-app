@page "/profile"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject UserStateService UserState
@inject PropertyService PropertyService
@inject ContactService ContactService

<PageTitle>HomeNest - Моят профил</PageTitle>

<div class="profile-page">
    <div class="section-container">
        @if (_loading)
        {
            <div style="text-align: center; padding: 64px 24px;">
                <div class="filter-spinner" style="margin: 0 auto;"></div>
                <p style="margin-top: 16px; color: var(--color-text-light);">Зареждане...</p>
            </div>
        }
        else if (!UserState.IsLoggedIn)
        {
            <div class="empty-state" style="background: var(--color-white); border-radius: var(--radius-xl); padding: 64px 24px; margin-top: 32px;">
                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" />
                </svg>
                <p class="empty-title">Влезте в акаунта си</p>
                <p class="empty-subtitle">Вижте профила си, любими имоти и управлявайте обявите.</p>
                <a href="/login?returnUrl=/profile" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Вход</a>
            </div>
        }
        else
        {
            @* Hero Profile Card *@
            <div class="profile-hero">
                <div class="profile-hero-avatar">
                    <span>@GetInitials(UserState.UserName)</span>
                </div>
                <div class="profile-hero-info">
                    <h2>@UserState.UserName</h2>
                    <p>@UserState.Email</p>
                    @if (!string.IsNullOrEmpty(UserState.Phone))
                    {
                        <p>@UserState.Phone</p>
                    }
                    @if (UserState.IsAdmin)
                    {
                        <div class="profile-hero-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                            Администратор
                        </div>
                    }
                </div>
            </div>

            @* Stats *@
            <div class="profile-stats-modern">
                <div class="profile-stat-card">
                    <div class="profile-stat-icon blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    </div>
                    <div class="stat-value" style="color: var(--color-secondary);">@_myListingsCount</div>
                    <div class="stat-label">Мои обяви</div>
                </div>
                <div class="profile-stat-card">
                    <div class="profile-stat-icon orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    </div>
                    <div class="stat-value" style="color: var(--color-primary);">@_favoritesCount</div>
                    <div class="stat-label">Любими</div>
                </div>
                <div class="profile-stat-card">
                    <div class="profile-stat-icon green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    </div>
                    <div class="stat-value" style="color: #28a745;">@_totalProperties</div>
                    <div class="stat-label">Общо имоти</div>
                </div>
                <div class="profile-stat-card">
                    <div class="profile-stat-icon purple">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </div>
                    <div class="stat-value" style="color: #6f42c1;">@_unreadMessages</div>
                    <div class="stat-label">Нови съобщения</div>
                </div>
            </div>

            @* Quick Actions *@
            <div class="profile-actions-bar">
                <a href="/property/publish" class="profile-btn profile-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Нова обява
                </a>
                <a href="/my-listings" class="profile-btn profile-btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                    Мои обяви
                </a>
                <a href="/favorites" class="profile-btn profile-btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    Любими
                </a>
                @if (UserState.IsAdmin)
                {
                    <a href="/admin" class="profile-btn profile-btn-outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Админ панел
                    </a>
                }
                <button class="profile-btn profile-btn-danger" @onclick="Logout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Изход
                </button>
            </div>

            @* Latest Favorites *@
            @if (_latestFavorites.Any())
            {
                <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 24px;">Последни любими</h2>
                <div class="properties-grid" style="margin-bottom: 48px;">
                    @foreach (var property in _latestFavorites)
                    {
                        <div class="property-card-search">
                            <div class="property-image-wrap">
                                <img src="@property.Image" alt="@property.Title" loading="lazy" />
                                <div class="property-badge">@property.Type</div>
                            </div>
                            <div class="property-content">
                                <h3 class="property-title">@property.Title</h3>
                                <p class="property-desc">@property.Description</p>
                                <div class="property-footer">
                                    <a href="/property/@property.Id" class="btn-secondary-sm">Виж повече</a>
                                    <div class="property-price">
                                        <span class="price-value">€@property.Price</span>
                                        <span class="price-unit">@property.PriceUnit</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private int _myListingsCount = 0;
    private int _favoritesCount = 0;
    private int _totalProperties = 0;
    private int _unreadMessages = 0;
    private List<Property> _latestFavorites = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        UserState.OnChange += OnUserStateChanged;
        await LoadStatsAsync();
    }

    public void Dispose()
    {
        UserState.OnChange -= OnUserStateChanged;
    }

    private void OnUserStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadStatsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadStatsAsync()
    {
        _loading = true;
        try
        {
            if (UserState.IsLoggedIn)
            {
                var myListings = await UserState.GetMyListingsAsync();
                _myListingsCount = myListings.Count;

                var favorites = await UserState.GetFavoritesAsync();
                _favoritesCount = favorites.Count;
                _latestFavorites = favorites.Take(3).ToList();
            }
            _totalProperties = await PropertyService.GetPropertyCountAsync();
            _unreadMessages = await ContactService.GetUnreadCountAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void Logout()
    {
        UserState.Logout();
        Navigation.NavigateTo("/");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return (parts[0][0] + "" + parts[1][0]).ToUpperInvariant();
        return name[..1].ToUpperInvariant();
    }
}
