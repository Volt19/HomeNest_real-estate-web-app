@page "/property/publish"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject PropertyService PropertyService
@inject UserStateService UserState
@inject IWebHostEnvironment Environment

<PageTitle>HomeNest - Публикувай имот</PageTitle>

<div class="publish-page">
    <div class="section-container">
        @if (!UserState.IsLoggedIn)
        {
            <div class="empty-state" style="background: var(--color-white); border-radius: var(--radius-xl); padding: 64px 24px; margin-top: 32px;">
                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" />
                </svg>
                <p class="empty-title">Влезте в акаунта си</p>
                <p class="empty-subtitle">Трябва да сте влезли, за да публикувате имот.</p>
                <a href="/login" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Вход</a>
            </div>
        }
        else
        {
            <div class="publish-hero">
                <h1>Публикувай имот</h1>
                <p>Попълнете детайлите за вашия имот и го публикувайте за минути.</p>
            </div>

            <div class="publish-card-modern">
                @* Basic Info *@
                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Основна информация
                </div>

                <div class="form-group-modern">
                    <label>Заглавие *</label>
                    <input type="text" @bind="_title" placeholder="Напр. Просторен тристаен апартамент" />
                </div>

                <div class="form-group-modern">
                    <label>Описание *</label>
                    <textarea @bind="_description" rows="4" placeholder="Опишете имота — локация, състояние, удобства..." />
                </div>

                <div class="form-row">
                    <div class="form-group-modern">
                        <label>Район *</label>
                        <select @bind="_district">
                            @foreach (var district in _districts)
                            {
                                <option value="@district">@district</option>
                            }
                        </select>
                    </div>
                    <div class="form-group-modern">
                        <label>Вид на имота *</label>
                        <select @bind="_type">
                            @foreach (var type in _propertyTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="publish-divider"></div>

                @* Details *@
                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    Детайли
                </div>

                <div class="form-row-3">
                    <div class="form-group-modern">
                        <label>Цена (€) *</label>
                        <input type="number" @bind="_price" placeholder="Напр. 550" />
                    </div>
                    <div class="form-group-modern">
                        <label>Площ (кв.м) *</label>
                        <input type="number" @bind="_area" placeholder="Напр. 80" />
                    </div>
                    <div class="form-group-modern">
                        <label>Брой стаи *</label>
                        <input type="number" @bind="_rooms" placeholder="Напр. 3" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group-modern">
                        <label>Етаж *</label>
                        <input type="number" @bind="_floor" placeholder="Напр. 3" />
                    </div>
                    <div class="form-group-modern" style="justify-content: flex-end;">
                        <label style="visibility: hidden;">Обзаведен</label>
                        <label class="checkbox-modern">
                            <input type="checkbox" @bind="_furnished" />
                            <span>Обзаведен имот</span>
                        </label>
                    </div>
                </div>

                <div class="publish-divider"></div>

                @* Image *@
                <div class="publish-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Снимка на имота
                </div>

                <div class="image-upload-modern @(!string.IsNullOrEmpty(_imagePreview) ? "has-image" : "")">
                    @if (!string.IsNullOrEmpty(_imagePreview))
                    {
                        <div class="image-upload-preview-modern">
                            <img src="@_imagePreview" alt="Preview" />
                            <button type="button" class="image-upload-remove-modern" @onclick="RemoveImage" title="Премахни снимката">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        <InputFile OnChange="LoadFiles" accept="image/*" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B5B0A8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p style="font-size: 15px; font-weight: 500; color: var(--color-text); margin-bottom: 4px;">Качи снимка</p>
                        <p style="font-size: 13px; color: var(--color-text-light);">Плъзни или кликни тук. Макс. 5 MB</p>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <span class="image-upload-error">@_uploadError</span>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="auth-error" style="margin-top: 16px;">@_error</div>
                }

                @if (_submitted)
                {
                    <div style="text-align: center; padding: 32px; margin-top: 24px; background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); border-radius: 16px;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#155724" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px;"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <h3 style="color: #155724; font-weight: 700; font-size: 20px; margin-bottom: 8px;">Имотът е публикуван успешно!</h3>
                        <p style="color: #155724; opacity: 0.8; margin-bottom: 16px;">Вашата обява вече е видима за всички потребители.</p>
                        <a href="/my-listings" class="btn-secondary" style="display: inline-flex;">Към моите обяви</a>
                    </div>
                }
                else
                {
                    <div class="publish-actions-modern">
                        <button class="btn-secondary" @onclick='() => Navigation.NavigateTo("/search")'>Отказ</button>
                        <button class="btn-primary" @onclick="HandlePublish">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Публикувай имота
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string _title = "";
    private string _description = "";
    private string _district = "Приморски";
    private string _type = "3-стаен";
    private int _price = 0;
    private int _area = 0;
    private int _rooms = 1;
    private int _floor = 1;
    private bool _furnished = false;
    private string _error = "";
    private string _uploadError = "";
    private bool _submitted = false;
    private string _imagePath = "";
    private string _imagePreview = "";

    private List<string> _districts = new();
    private List<string> _propertyTypes = new();

    protected override void OnInitialized()
    {
        _districts = PropertyService.GetDistricts().Where(d => d != "Всички").ToList();
        _propertyTypes = PropertyService.GetPropertyTypes().Where(t => t != "Всички").ToList();
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        _uploadError = "";
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            _uploadError = "Снимката трябва да е по-малка от 5 MB.";
            return;
        }

        var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads");
        if (!Directory.Exists(uploadsFolder))
        {
            Directory.CreateDirectory(uploadsFolder);
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" };
        if (!allowedExtensions.Contains(extension))
        {
            _uploadError = "Разрешени формати: JPG, PNG, WEBP, GIF.";
            return;
        }

        var trustedFileName = $"{Guid.NewGuid()}{extension}";
        var filePath = Path.Combine(uploadsFolder, trustedFileName);

        try
        {
            await using var fs = new FileStream(filePath, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(fs);
            _imagePath = $"uploads/{trustedFileName}";
            _imagePreview = _imagePath;
        }
        catch
        {
            _uploadError = "Грешка при качване на снимката. Опитайте отново.";
        }
    }

    private void RemoveImage()
    {
        if (!string.IsNullOrEmpty(_imagePath))
        {
            var fullPath = Path.Combine(Environment.WebRootPath, _imagePath);
            try
            {
                if (File.Exists(fullPath))
                {
                    File.Delete(fullPath);
                }
            }
            catch { }
        }
        _imagePath = "";
        _imagePreview = "";
        _uploadError = "";
    }

    private async Task HandlePublish()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_description) || _price <= 0 || _area <= 0)
        {
            _error = "Моля, попълнете всички задължителни полета коректно.";
            return;
        }

        var property = new Property
        {
            Title = _title,
            Description = _description,
            Price = _price,
            Area = _area,
            Rooms = _rooms,
            District = _district,
            Type = _type,
            Furnished = _furnished,
            Floor = _floor,
            Image = string.IsNullOrEmpty(_imagePath) ? "images/property-1.jpg" : _imagePath,
            PriceUnit = "/ месец",
            FeaturesList = new() { $"{_rooms} стаен", _furnished ? "Обзаведен" : "Необзаведен", $"{_area} кв.м" },
            OwnerId = UserState.UserId
        };

        await PropertyService.AddPropertyAsync(property);
        _submitted = true;
    }
}
