@page "/search"
@rendermode InteractiveServer
@inject PropertyService PropertyService

<PageTitle>HomeNest - Търсене на имоти</PageTitle>

<div class="search-page">
    @* Filter Section *@
    <section class="filter-section">
        <div class="section-container">
            <h1 class="filter-title">Филтрирай бързо и лесно</h1>
            <div class="filter-card">
                <div class="filter-grid">
                    <div class="filter-col">
                        <div class="filter-group">
                            <label class="filter-label">Цена (€)</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       @bind="priceFrom" @bind:after="ApplyFilters" />
                                <input type="number" placeholder="до" class="filter-input"
                                       @bind="priceTo" @bind:after="ApplyFilters" />
                            </div>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Площ (кв.м)</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       @bind="areaFrom" @bind:after="ApplyFilters" />
                                <input type="number" placeholder="до" class="filter-input"
                                       @bind="areaTo" @bind:after="ApplyFilters" />
                            </div>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Етаж</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       @bind="floorFrom" @bind:after="ApplyFilters" />
                                <input type="number" placeholder="до" class="filter-input"
                                       @bind="floorTo" @bind:after="ApplyFilters" />
                            </div>
                        </div>
                    </div>
                    <div class="filter-col">
                        <div class="filter-group">
                            <label class="filter-label">Район</label>
                            <select class="filter-select" @bind="selectedDistrict" @bind:after="ApplyFilters">
                                @foreach (var district in districts)
                                {
                                    <option value="@district">@district</option>
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Вид на имота</label>
                            <select class="filter-select" @bind="selectedType" @bind:after="ApplyFilters">
                                @foreach (var type in propertyTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Сортиране</label>
                            <select class="filter-select" @bind="sortBy" @bind:after="ApplyFilters">
                                @foreach (var opt in sortOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="filter-cta">
                    @if (HasActiveFilters)
                    {
                        <button class="btn-pill btn-pill-outline" @onclick="ClearFilters">Изчисти филтрите</button>
                    }
                    <button class="btn-search-primary">
                        <span>Показани @filteredProperties.Count имота</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    @* Active Filters Chips *@
    @if (HasActiveFilters)
    {
        <section class="active-filters-section">
            <div class="section-container">
                <div class="active-filters">
                    @if (priceFrom.HasValue || priceTo.HasValue)
                    {
                        <span class="filter-chip">
                            Цена: @(priceFrom?.ToString() ?? "0") - @(priceTo?.ToString() ?? "∞") €
                            <button @onclick="ClearPriceFilter">×</button>
                        </span>
                    }
                    @if (areaFrom.HasValue || areaTo.HasValue)
                    {
                        <span class="filter-chip">
                            Площ: @(areaFrom?.ToString() ?? "0") - @(areaTo?.ToString() ?? "∞") кв.м
                            <button @onclick="ClearAreaFilter">×</button>
                        </span>
                    }
                    @if (floorFrom.HasValue || floorTo.HasValue)
                    {
                        <span class="filter-chip">
                            Етаж: @(floorFrom?.ToString() ?? "0") - @(floorTo?.ToString() ?? "∞")
                            <button @onclick="ClearFloorFilter">×</button>
                        </span>
                    }
                    @if (selectedDistrict != "Всички")
                    {
                        <span class="filter-chip">
                            @selectedDistrict
                            <button @onclick="ClearDistrictFilter">×</button>
                        </span>
                    }
                    @if (selectedType != "Всички")
                    {
                        <span class="filter-chip">
                            @selectedType
                            <button @onclick="ClearTypeFilter">×</button>
                        </span>
                    }
                </div>
            </div>
        </section>
    }

    @* Properties Section *@
    <section class="properties-section">
        <div class="section-container">
            <h2 class="properties-title">Имоти</h2>
            @if (_loading)
            {
                <div style="text-align: center; padding: 64px 24px;">
                    <div class="filter-spinner" style="margin: 0 auto;"></div>
                    <p style="margin-top: 16px; color: var(--color-text-light);">Зареждане...</p>
                </div>
            }
            else if (filteredProperties.Count == 0)
            {
                <div class="empty-state">
                    <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <p class="empty-title">Няма намерени имоти</p>
                    <p class="empty-subtitle">Опитайте да промените филтрите или изчистете всички</p>
                    <button class="btn-search-primary" @onclick="ClearFilters">Изчисти филтрите</button>
                </div>
            }
            else
            {
                <div class="properties-grid">
                    @foreach (var property in filteredProperties)
                    {
                        <div class="property-card-search" @key="property.Id">
                            <div class="property-image-wrap">
                                <img src="@property.Image" alt="@property.Title" loading="lazy" />
                                <div class="property-badge">@property.Type</div>
                            </div>
                            <div class="property-content">
                                <h3 class="property-title">@property.Title</h3>
                                <p class="property-desc">@property.Description</p>
                                <div class="property-meta">
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5" /></svg>
                                        @property.Area кв.м
                                    </span>
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 20h10M6 4h12a1 1 0 011 1v14a1 1 0 01-1 1H6a1 1 0 01-1-1V5a1 1 0 011-1z" /></svg>
                                        Етаж @property.Floor
                                    </span>
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3v18M19 3v18M5 12h14" /></svg>
                                        @property.Rooms @(property.Rooms == 1 ? "стая" : "стаи")
                                    </span>
                                </div>
                                <div class="property-footer">
                                    <a href="/property/@property.Id" class="btn-secondary-sm">Виж повече</a>
                                    <div class="property-price">
                                        <span class="price-value">€@property.Price</span>
                                        <span class="price-unit">@property.PriceUnit</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <NewsletterSection />
</div>

@code {
    private int? priceFrom;
    private int? priceTo;
    private int? areaFrom;
    private int? areaTo;
    private int? floorFrom;
    private int? floorTo;
    private string selectedDistrict = "Всички";
    private string selectedType = "Всички";
    private string sortBy = "default";

    private List<Property> filteredProperties = new();
    private List<Property> allProperties = new();
    private List<string> districts = new();
    private List<string> propertyTypes = new();
    private List<SortOption> sortOptions = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        districts = PropertyService.GetDistricts();
        propertyTypes = PropertyService.GetPropertyTypes();
        sortOptions = PropertyService.GetSortOptions();
        allProperties = await PropertyService.GetAllPropertiesAsync();
        _loading = false;
        ApplyFilters();
    }

    private bool HasActiveFilters =>
        priceFrom.HasValue ||
        priceTo.HasValue ||
        areaFrom.HasValue ||
        areaTo.HasValue ||
        floorFrom.HasValue ||
        floorTo.HasValue ||
        selectedDistrict != "Всички" ||
        selectedType != "Всички";

    private void ApplyFilters()
    {
        var result = allProperties.AsEnumerable();

        if (priceFrom.HasValue)
            result = result.Where(p => p.Price >= priceFrom.Value);

        if (priceTo.HasValue)
            result = result.Where(p => p.Price <= priceTo.Value);

        if (areaFrom.HasValue)
            result = result.Where(p => p.Area >= areaFrom.Value);

        if (areaTo.HasValue)
            result = result.Where(p => p.Area <= areaTo.Value);

        if (floorFrom.HasValue)
            result = result.Where(p => p.Floor >= floorFrom.Value);

        if (floorTo.HasValue)
            result = result.Where(p => p.Floor <= floorTo.Value);

        if (selectedDistrict != "Всички")
            result = result.Where(p => p.District == selectedDistrict);

        if (selectedType != "Всички")
            result = result.Where(p => p.Type == selectedType);

        result = sortBy switch
        {
            "price-asc" => result.OrderBy(p => p.Price),
            "price-desc" => result.OrderByDescending(p => p.Price),
            "area-asc" => result.OrderBy(p => p.Area),
            "area-desc" => result.OrderByDescending(p => p.Area),
            _ => result
        };

        filteredProperties = result.ToList();
    }

    private void ClearFilters()
    {
        priceFrom = null;
        priceTo = null;
        areaFrom = null;
        areaTo = null;
        floorFrom = null;
        floorTo = null;
        selectedDistrict = "Всички";
        selectedType = "Всички";
        sortBy = "default";
        ApplyFilters();
    }

    private void ClearPriceFilter()
    {
        priceFrom = null;
        priceTo = null;
        ApplyFilters();
    }

    private void ClearAreaFilter()
    {
        areaFrom = null;
        areaTo = null;
        ApplyFilters();
    }

    private void ClearFloorFilter()
    {
        floorFrom = null;
        floorTo = null;
        ApplyFilters();
    }

    private void ClearDistrictFilter()
    {
        selectedDistrict = "Всички";
        ApplyFilters();
    }

    private void ClearTypeFilter()
    {
        selectedType = "Всички";
        ApplyFilters();
    }
}
