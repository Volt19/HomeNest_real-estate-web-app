@page "/team"
@rendermode InteractiveServer

<PageTitle>HomeNest - Екип</PageTitle>

<div class="team-page">
    <div class="section-container">
        <h1 class="team-title">Нашият екип</h1>
        <p class="team-subtitle">Запознайте се с професионалистите, които ще ви помогнат да намерите перфектния дом.</p>

        <div class="team-grid">
            <div class="team-card">
                <div class="team-photo">
                    <img src="images/broker.jpg" alt="Димитър Тодоров" />
                </div>
                <h3 class="team-name">Димитър Тодоров</h3>
                <p class="team-role">Главен брокер</p>
                <p class="team-bio">С над 15 години опит в имотния пазар на Варна. Специалист в луксозните имоти и инвестициите.</p>
                <div class="team-social">
                    <a href="#" aria-label="LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
                    </a>
                    <a href="#" aria-label="Email">
