

<header class="homenest-header navbar">

    <div class="header-container   ">
        @* Logo *@
        <a href="/" class="logo">
            <div class="logo-container">
                <img class="logo-icon" width="" src="./images/swallow.png">
                <span class="logo-text">HomeNest</span>
            </div>

        </a>

        @* Navigation Pill *@
        <nav class="nav-pill">
            <NavLink href="/search" class="nav-link" Match="NavLinkMatch.Prefix">Търси</NavLink>
            <NavLink href="/listings" class="nav-link" Match="NavLinkMatch.Prefix">Обяви</NavLink>
            <NavLink href="/about" class="nav-link" Match="NavLinkMatch.Prefix">За нас</NavLink>
            <NavLink href="/contact" class="nav-link" Match="NavLinkMatch.Prefix">Контакт</NavLink>
        </nav>

        @* Auth Buttons *@
        <div class="auth-buttons">
            <button class="btn-signin" @onclick="OnSignInClick">Sign in</button>
            <button class="btn-login" @onclick="OnLogInClick">Log in</button>
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnSignIn { get; set; }
    [Parameter] public EventCallback OnLogIn { get; set; }

    private async Task OnSignInClick() => await OnSignIn.InvokeAsync();
    private async Task OnLogInClick() => await OnLogIn.InvokeAsync();
}

<style>
    /* wwwroot/css/header.css or in your global CSS */

    .homenest-header {
        background-color: #F9F0DE; /* Cream/beige background */
        padding: 1rem 2rem;
        height: auto;
        box-shadow: 0 1px 3px rgba(57, 56, 58, 0.08);
        border-radius: 100px;
    }

    .header-container {
        max-width: 1400px;
        width:100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    /* Logo */
    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: #39383A;
        transition: opacity 0.2s ease;
    }

        .logo:hover {
            opacity: 0.8;
        }

    .logo-text {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #39383A;
    }

    /* Navigation Pill */
    .nav-pill {
        display: flex;
        align-items: center;
        background-color: #FFFFFF;
        border-radius: 100px;
        padding: 0.5rem 1.5rem;
        gap: 0.25rem;
        box-shadow: 0 2px 8px rgba(57, 56, 58, 0.06);
    }

    .nav-link {
        padding: 0.625rem 1.25rem;
        border-radius: 50px;
        text-decoration: none;
        color: #39383A;
        font-weight: 500;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .nav-link:hover {
            background-color: #F9F0DE;
            color: #4C5F8A;
        }

        /* Active link styling */
        .nav-link.active {
            background-color: #4C5F8A;
            color: #FFFFFF;
        }

    /* Auth Buttons */
    .auth-buttons {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 1.5px solid #39383A;
        border-radius: 50px;
        padding: 0.35rem;
    }

    .btn-signin {
        padding: 0.625rem 1.5rem;
        border-radius: 50px;
        border: none;
        background: transparent;
        color: #39383A;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-signin:hover {
            background-color: rgba(57, 56, 58, 0.05);
        }

    .btn-login {
        padding: 0.625rem 1.5rem;
        border-radius: 50px;
        border: none;
        background-color: #4C5F8A;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-login:hover {
            background-color: #3a4a6e;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(76, 95, 138, 0.3);
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .header-container

    {
        flex-wrap: wrap;
    }

    .nav-pill {
        order: 3;
        width: 100%;
        justify-content: center;
    }

    }

    @@media (max-width: 576px) {
        .homenest-header

    {
        padding: 1rem;
    }

    .logo-text {
        font-size: 1.25rem;
    }

    .nav-link {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }

    .btn-signin, .btn-login {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
    }

        .logo-container {
            display: flex;
            flex-direction: column; 
            align-items: center; 
           
        }

    }</style>
