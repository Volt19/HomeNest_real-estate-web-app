@rendermode InteractiveServer
@implements IDisposable

<div style="background-color: #FFFFFF;">
<header class="homenest-header">
    <div class="header-container">
        @* Logo *@
        <a href="/" class="logo">
            <div class="logo-container">
                <img class="logo-icon" src="./images/swallow.png" alt="HomeNest logo" />
                <span class="logo-text">HomeNest</span>
            </div>
        </a>

        @* Navigation Pill *@
        <nav class="nav-pill @(_mobileMenuOpen ? "nav-pill-open" : "")">
            <NavLink href="/search" class="nav-link" Match="NavLinkMatch.Prefix">Търси</NavLink>
            <NavLink href="/property/publish" class="nav-link" Match="NavLinkMatch.Prefix">Обяви</NavLink>
            <NavLink href="/about" class="nav-link" Match="NavLinkMatch.All">За нас</NavLink>
            <NavLink href="/team" class="nav-link" Match="NavLinkMatch.Prefix">Екип</NavLink>
            <NavLink href="/contact" class="nav-link" Match="NavLinkMatch.Prefix">Контакт</NavLink>

            @if (UserState.IsLoggedIn)
            {
                <div class="nav-pill-auth mobile-only">
                    <a href="/profile" class="btn-login">Профил</a>
                    <button class="btn-signin" @onclick="Logout">Изход</button>
                </div>
            }
            else
            {
                <div class="nav-pill-auth mobile-only">
                    <a href="/register" class="btn-signin">Регистрация</a>
                    <a href="/login" class="btn-login">Вход</a>
                </div>
            }
        </nav>

        @* Auth Buttons *@
        <div class="auth-buttons desktop-only">
            @if (UserState.IsLoggedIn)
            {
                <div class="user-menu">
                    <button class="user-menu-toggle" @onclick="ToggleUserMenu">
                        <div class="user-avatar">
                            <span>@GetInitials(UserState.UserName)</span>
                        </div>
                        <span class="user-name">@UserState.UserName</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                    </button>
                    @if (_userMenuOpen)
                    {
                            <div class="user-dropdown" @onclick:stopPropagation="true">
                            <div class="user-dropdown-header">
                                <div class="user-avatar-lg">
                                    <span>@GetInitials(UserState.UserName)</span>
                                </div>
                                <div>
                                    <p class="user-dropdown-name">@UserState.UserName</p>
                                    <p class="user-dropdown-email">@UserState.Email</p>
                                </div>
                            </div>
                            <div class="user-dropdown-divider"></div>
                            <a href="/profile">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Профил
                            </a>
                            <a href="/my-listings">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                                Мои обяви
                            </a>
                            <a href="/favorites">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                                Любими
                            </a>
                            @if (UserState.IsAdmin)
                            {
                                <a href="/admin">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    Админ панел
                                </a>
                            }
                            <div class="user-dropdown-divider"></div>
                            <button @onclick="Logout">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Изход
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/register" class="btn-signin">Регистрация</a>
                <a href="/login" class="btn-login">Вход</a>
            }
        </div>

        @* Mobile Menu Toggle *@
        <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle menu">
            @if (_mobileMenuOpen)
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            }
            else
            {
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            }
        </button>
    </div>
    </header>
</div>

@code {

    private bool _mobileMenuOpen = false;
    private bool _userMenuOpen = false;

    [Inject] private UserStateService UserState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override void OnInitialized()
    {
        UserState.OnChange += OnUserStateChanged;
    }

    public void Dispose()
    {
        UserState.OnChange -= OnUserStateChanged;
    }

    private void OnUserStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }



    private async Task ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;

        if (_userMenuOpen)
        {
            // Small delay so the toggle click itself doesn't immediately close it
            await Task.Delay(800);
            await JS.InvokeVoidAsync("eval", @"
            setTimeout(() => {
                const closeMenu = (e) => {
                    if (!e.target.closest('.user-menu')) {
                        document.querySelector('.user-menu-toggle').dispatchEvent(new Event('click', { bubbles: true }));
                        document.removeEventListener('click', closeMenu);
                    }
                };
                document.addEventListener('click', closeMenu);
            }, 0);
        ");
        }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("homenestAuth.logout");
        UserState.Logout();
        _userMenuOpen = false;
        _mobileMenuOpen = false;
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return (parts[0][0] + "" + parts[1][0]).ToUpperInvariant();
        return name[..1].ToUpperInvariant();
    }
}
