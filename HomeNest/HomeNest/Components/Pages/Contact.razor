@page "/contact"
@rendermode InteractiveServer
@inject ContactService ContactService

<PageTitle>HomeNest - Контакт</PageTitle>

<div class="contact-page">
    <div class="section-container">
        <h1 class="contact-title">Свържете се с нас</h1>
        <p class="contact-subtitle">Имате въпроси? Нашият екип е тук, за да ви помогне.</p>

        <div class="contact-grid">
            <div class="contact-info-card">
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                    </div>
                    <div class="contact-info-text">
                        <h4>Адрес</h4>
                        <p>бул. "Приморски" 45<br />9000 Варна, България</p>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
                        </svg>
                    </div>
                    <div class="contact-info-text">
                        <h4>Телефон</h4>
                        <p>+359 52 123 456<br />+359 88 888 8888</p>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                    </div>
                    <div class="contact-info-text">
                        <h4>Имейл</h4>
                        <p>info@homenest.bg<br />support@homenest.bg</p>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                    </div>
                    <div class="contact-info-text">
                        <h4>Работно време</h4>
                        <p>Пон - Пет: 9:00 - 18:00<br />Съб: 10:00 - 14:00</p>
                    </div>
                </div>
            </div>

            <div class="contact-form-card">
                @if (_submitted)
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <div style="width: 64px; height: 64px; margin: 0 auto 20px; background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#155724" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <h3 style="font-size: 24px; font-weight: 700; color: var(--color-text); margin-bottom: 12px;">Благодарим ви!</h3>
                        <p style="color: var(--color-text-light); line-height: 1.6;">Съобщението ви е изпратено успешно. Ще се свържем с вас възможно най-скоро.</p>
                        <button class="btn-secondary" style="margin-top: 24px;" @onclick="ResetForm">Ново съобщение</button>
                    </div>
                }
                else
                {
                    <div class="contact-form-group">
                        <label>Име</label>
                        <input type="text" @bind="_name" placeholder="Вашето име" />
                    </div>
                    <div class="contact-form-group">
                        <label>Имейл</label>
                        <input type="email" @bind="_email" placeholder="your@email.com" />
                    </div>
                    <div class="contact-form-group">
                        <label>Телефон</label>
                        <input type="tel" @bind="_phone" placeholder="+359 88 888 8888" />
                    </div>
                    <div class="contact-form-group">
                        <label>Съобщение</label>
                        <textarea @bind="_message" placeholder="Опишете вашето запитване..."></textarea>
                    </div>
                    <button class="btn-primary" style="width: 100%; margin-top: 8px;" @onclick="SubmitForm">Изпрати съобщение</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _name = "";
    private string _email = "";
    private string _phone = "";
    private string _message = "";
    private bool _submitted = false;

    private async Task SubmitForm()
    {
        if (!string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_email) && !string.IsNullOrWhiteSpace(_message))
        {
            await ContactService.AddAsync(new ContactMessage
            {
                Name = _name,
                Email = _email,
                Phone = _phone,
                Message = _message
            });
            _submitted = true;
        }
    }

    private void ResetForm()
    {
        _name = "";
        _email = "";
        _phone = "";
        _message = "";
        _submitted = false;
    }
}
