@page "/favorites"
@rendermode InteractiveServer
@inject PropertyService PropertyService
@inject UserStateService UserState
@inject NavigationManager Navigation

<PageTitle>HomeNest - Любими имоти</PageTitle>

<div class="favorites-page">
    <div class="section-container">
        <h1 class="favorites-title">Любими имоти</h1>
        <p class="favorites-subtitle">Имотите, които сте запазили за по-късно преглеждане.</p>

        @if (_loading)
        {
            <div style="text-align: center; padding: 64px 24px;">
                <div class="filter-spinner" style="margin: 0 auto;"></div>
                <p style="margin-top: 16px; color: var(--color-text-light);">Зареждане...</p>
            </div>
        }
        else if (!UserState.IsLoggedIn)
        {
            <div class="empty-state" style="background: var(--color-white); border-radius: var(--radius-xl); padding: 64px 24px; margin-top: 32px;">
                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                </svg>
                <p class="empty-title">Влезте в акаунта си</p>
                <p class="empty-subtitle">Запазвайте любими имоти и ги виждайте по всяко време.</p>
                <a href="/login?returnUrl=/favorites" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Вход</a>
            </div>
        }
        else if (!_favoriteProperties.Any())
        {
            <div class="empty-state" style="background: var(--color-white); border-radius: var(--radius-xl); padding: 64px 24px; margin-top: 32px;">
                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                </svg>
                <p class="empty-title">Нямате любими имоти</p>
                <p class="empty-subtitle">Разгледайте нашите оферти и запазете тези, които ви харесват.</p>
                <a href="/search" class="btn-primary" style="margin-top: 16px; display: inline-flex;">Разгледай имоти</a>
            </div>
        }
        else
        {
            <div class="properties-grid" style="margin-top: 32px;">
                @foreach (var property in _favoriteProperties)
                {
                    <div class="property-card-search">
                        <div class="property-image-wrap">
                            <img src="@property.Image" alt="@property.Title" loading="lazy" />
                            <div class="property-badge">@property.Type</div>
                            <button class="favorite-btn active" @onclick="() => ToggleFavorite(property.Id)" aria-label="Премахни от любими">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" /></svg>
                            </button>
                        </div>
                        <div class="property-content">
                            <h3 class="property-title">@property.Title</h3>
                            <p class="property-desc">@property.Description</p>
                            <div class="property-meta">
                                <span class="meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5" /></svg>
                                    @property.Area кв.м
                                </span>
                                <span class="meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 20h10M6 4h12a1 1 0 011 1v14a1 1 0 01-1 1H6a1 1 0 01-1-1V5a1 1 0 011-1z" /></svg>
                                    Етаж @property.Floor
                                </span>
                                <span class="meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3v18M19 3v18M5 12h14" /></svg>
                                    @property.Rooms @(property.Rooms == 1 ? "стая" : "стаи")
                                </span>
                            </div>
                            <div class="property-footer">
                                <a href="/property/@property.Id" class="btn-secondary-sm">Виж повече</a>
                                <div class="property-price">
                                    <span class="price-value">€@property.Price</span>
                                    <span class="price-unit">@property.PriceUnit</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Property> _favoriteProperties = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        UserState.OnChange += OnUserStateChanged;
        await LoadFavoritesAsync();
    }

    public void Dispose()
    {
        UserState.OnChange -= OnUserStateChanged;
    }

    private void OnUserStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadFavoritesAsync();
            StateHasChanged();
        });
    }

    private async Task LoadFavoritesAsync()
    {
        _loading = true;
        _favoriteProperties = await UserState.GetFavoritesAsync();
        _loading = false;
    }

    private async Task ToggleFavorite(int id)
    {
        await UserState.ToggleFavoriteAsync(id);
    }
}
