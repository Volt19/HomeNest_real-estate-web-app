    @* Hero Section *@
    <section class="hero">
        <div class="hero-image-wrapper">
            <img src="images/hero-bg.png" alt="" class="hero-bg-image" />
        </div>
        <div class="hero-content">
            <h1 class="hero-title">
                <span>Your place,</span>
                <span>your home</span>
            </h1>
            <p class="hero-subtitle">You will have everything nearby supermarket, buses, station, the carmen neighborhood, etc</p>
            <div class="hero-buttons">
                <button class="btn-hero-primary">Search now!</button>
                <button class="btn-hero-secondary">Inquiry</button>
            </div>
        </div>
        <div class="hero-house">
            <img src="images/hero-house.png" alt="Modern House" />
        </div>
    </section>

