    private string GetRoomLabel(int rooms)
    {
        if (rooms == 1) return "стаен";
        if (rooms == 2) return "стаен";
        return "стаен";
    }

    private string GetFloorLabel(int floor)
    {
        if (floor == 1) return "1-ви";
        if (floor == 2) return "2-ри";
        if (floor == 3) return "3-ти";
        if (floor == 4) return "4-ти";
        if (floor == 5) return "5-ти";
        if (floor == 6) return "6-ти";
        if (floor == 7) return "7-ми";
        if (floor == 8) return "8-ми";
        return $"{floor}-ти";
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
        --bg: #F9F0DE;
        --text: #39383A;
        --text-light: #7A787B;
        --primary: #E65D36;
        --secondary: #4C5F8A;
        --white: #FFFFFF;
        --border: #E5DDD0;
        --font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .about-page {
        min-height: 100vh;
        /* background: var(--bg); */
        font-family: var(--font);
    }

    /* ===== Navbar ===== */
    .search-navbar {
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }

    .search-navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
    }

    .search-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .search-logo-icon {
        width: 42px;
        height: 19px;
        flex-shrink: 0;
    }

    .search-logo-text {
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
    }

    .search-nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .search-nav-links a {
        font-size: 14px;
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        transition: color 0.2s;
    }

    .search-nav-links a:hover {
        color: var(--primary);
    }

    .nav-auth {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-pill {
        padding: 8px 20px;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        font-family: var(--font);
    }

    .btn-pill-outline {
        background: transparent;
        color: var(--secondary);
        border: 1.5px solid var(--secondary);
    }

    .btn-pill-outline:hover {
        background: var(--secondary);
        color: white;
    }

    .btn-pill-solid {
        background: var(--secondary);
        color: white;
    }

    .btn-pill-solid:hover {
        background: #5a6f9a;
        transform: scale(1.02);
    }

    .btn-primary {
        padding: 14px 48px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-family: var(--font);
        box-shadow: 0 4px 16px rgba(230, 93, 54, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary:hover {
        background: #d4542f;
        transform: scale(1.02);
    }

    /* ===== Section Container ===== */
    .section-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* ===== About Content ===== */
    .about-content {
        padding: 32px 0 64px;
    }

    .about-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .about-title {
        font-size: 40px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -1px;
    }

    .about-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .icon-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid var(--border);
        background: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
    }

    .icon-btn:hover {
        border-color: var(--secondary);
        transform: scale(1.05);
    }

    .btn-rent-buy {
        padding: 12px 24px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 24px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-family: var(--font);
        box-shadow: 0 4px 16px rgba(230, 93, 54, 0.3);
    }

    .btn-rent-buy:hover {
        background: #d4542f;
        transform: scale(1.02);
    }

    /* ===== Gallery ===== */
    .gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .gallery-item {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        aspect-ratio: 3/4;
    }

    .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .gallery-item:hover img {
        transform: scale(1.03);
    }

    .gallery-last {
        position: relative;
    }

    .gallery-next {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(57, 56, 58, 0.7);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
    }

    .gallery-next:hover {
        background: rgba(57, 56, 58, 0.9);
