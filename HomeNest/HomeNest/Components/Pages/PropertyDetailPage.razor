@page "/property/{id}"
@using HomeNest.Data.Models
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject PropertyService PropertyService
@inject UserStateService UserState
@inject NavigationManager Navigation

<PageTitle>@pageTitle</PageTitle>

<div class="about-page">
    @if (property == null)
    {
        <div class="section-container" style="padding: 80px 24px; text-align: center;">
            <h1>Имотът не е намерен</h1>
            <p style="color: var(--color-text-light); margin-top: 16px;">Имотът, който търсите, не съществува или е премахнат.</p>
            <a href="/search" class="btn-primary" style="margin-top: 24px; display: inline-flex;">Към търсене</a>
        </div>
    }
    else
    {
        <div class="about-content">
            <div class="section-container">
                @* Header Row *@
                <div class="about-header">
                    <h1 class="about-title">@property.Title</h1>
                    <div class="about-actions">
                        <button class="icon-btn @(_isFavorite ? "active" : "")" @onclick="ToggleFavorite" aria-label="Добави в любими">
                            @if (_isFavorite)
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="#E65D36" stroke="#E65D36" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                            }
                            else
                            {
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#39383A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                            }
                        </button>
                        <button class="icon-btn" aria-label="Сподели">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#39383A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 17L17 7M17 7H7M17 7V17" />
                            </svg>
                        </button>
                        <a href="/contact" class="btn-rent-buy">Наеми/Купи</a>
                    </div>
                </div>

                @* Image Carousel *@
                <div class="property-carousel">
                    <div class="carousel-counter">@(_currentImageIndex + 1) / @_carouselImages.Count</div>
                    <div class="carousel-main">
                        @for (int i = 0; i < _carouselImages.Count; i++)
                        {
                            <img src="@_carouselImages[i]" alt="@property.Title - @(i + 1)" class="@(_currentImageIndex == i ? "active" : "")" />
                        }
                    </div>
                    @if (_carouselImages.Count > 1)
                    {
                        <button class="carousel-nav prev" @onclick="PrevImage" aria-label="Предишна">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                        </button>
                        <button class="carousel-nav next" @onclick="NextImage" aria-label="Следваща">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                        <div class="carousel-dots">
                            @for (int i = 0; i < _carouselImages.Count; i++)
                            {
                                <button class="carousel-dot @(_currentImageIndex == i ? "active" : "")" @onclick="() => GoToImage(i)" aria-label="Снимка @(i + 1)"></button>
                            }
                        </div>
                    }
                    <div class="carousel-thumbnails">
                        @for (int i = 0; i < _carouselImages.Count; i++)
                        {
                            <img src="@_carouselImages[i]" alt="Thumb @(i + 1)" class="@(_currentImageIndex == i ? "active" : "")" @onclick="() => GoToImage(i)" />
                        }
                    </div>
                </div>

                @* Stats Bar *@
                <div class="stats-bar">
                    <div class="stat-card">
                        <div class="stat-value">@property.Price€</div>
                        <div class="stat-label">Цена</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">@property.Area м²</div>
                        <div class="stat-label">Площ</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">@property.District</div>
                        <div class="stat-label">Район/Квартал</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">@property.Rooms @(GetRoomLabel(property.Rooms))</div>
                        <div class="stat-label">Брой стаи на имота</div>
                    </div>
                </div>

                @* Details *@
                <div class="details">
                    <h3 class="details-heading">ДЕТАЙЛИ:</h3>
                    <p class="details-text">
                        Отдава се под наем просторен @property.Title.ToLower() в предпочитания район @property.District, гр. Варна.
                        Жилището се намира на @GetFloorLabel(property.Floor) етаж в поддържана сграда и предлага
                        функционално разпределение и много естествена светлина. Състои се от уютна дневна,
                        @(property.Rooms > 1 ? $"{property.Rooms - 1} комфортни спални" : "обособена спалня зона"),
                        кухня, баня с тоалетна и тераса с приятна гледка към околността.
                        Районът е изключително комуникативен – в близост до централни улици, магазини, училища и удобен градски транспорт.
                        Имотът е подходящ както за семейство, така и за работещи хора, търсещи комфорт и удобство.
                        @(property.Furnished ? "Апартаментът е напълно обзаведен с качествени мебели и уреди." : "Апартаментът се отдава необзаведен, давайки възможност за персонализация.")
                    </p>
                </div>

                @* Broker Section *@
                <h2 class="broker-section-title">Брокер</h2>
                <div class="broker-card">
                    <div class="broker-photo">
                        <img src="images/broker.jpg" alt="Димитър Тодоров" />
                    </div>
                    <div class="broker-info">
                        <h3 class="broker-name">Димитър Тодоров</h3>
                        <p class="broker-subtitle">най-добър брокер за район @property.District</p>
                        <div class="broker-actions">
                            <button class="btn-broker-primary">Виж профил</button>
                            <a href="/contact" class="btn-broker-outline">Свържи се с мен</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Similar Properties *@
        @if (similarProperties.Any())
        {
            <div class="section-container" style="margin-bottom: 64px;">
                <h2 style="font-size: 32px; font-weight: 700; color: var(--color-text); margin-bottom: 32px; text-align: center;">Подобни имоти</h2>
                <div class="properties-grid">
                    @foreach (var similar in similarProperties)
                    {
                        <PropertyCard Property="similar" ShowRooms="false" />
                    }
                </div>
            </div>
        }

        <NewsletterSection />
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Property? property;
    private List<Property> similarProperties = new();
    private string pageTitle = "HomeNest - Детайли за имот";
    private bool _isFavorite = false;

    private List<string> _carouselImages = new();
    private int _currentImageIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out var id))
        {
            property = await PropertyService.GetPropertyByIdAsync(id);
            if (property != null)
            {
                pageTitle = $"{property.Title} - HomeNest";
                var all = await PropertyService.GetAllPropertiesAsync();
                similarProperties = all
                    .Where(p => p.Id != property.Id)
                    .Where(p => p.District == property.District || p.Type == property.Type)
                    .Take(3)
                    .ToList();

                _isFavorite = await UserState.IsFavoriteAsync(property.Id);

                // Build carousel images
                _carouselImages = new List<string> { property.Image };
                var extras = new[] { "images/gallery-1.jpg", "images/gallery-2.jpg", "images/gallery-3.jpg" };
                foreach (var img in extras)
                {
                    if (!_carouselImages.Contains(img))
                        _carouselImages.Add(img);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void NextImage()
    {
        _currentImageIndex = (_currentImageIndex + 1) % _carouselImages.Count;
    }

    private void PrevImage()
    {
        _currentImageIndex = (_currentImageIndex - 1 + _carouselImages.Count) % _carouselImages.Count;
    }

    private void GoToImage(int index)
    {
        _currentImageIndex = index;
    }

    private async Task ToggleFavorite()
    {
        if (property != null)
        {
            await UserState.ToggleFavoriteAsync(property.Id);
            _isFavorite = await UserState.IsFavoriteAsync(property.Id);
        }
    }

    private string GetRoomLabel(int rooms)
    {
        return rooms == 1 ? "стаен" : "стаен";
    }

    private string GetFloorLabel(int floor)
    {
        return floor switch
        {
            1 => "1-ви",
            2 => "2-ри",
            3 => "3-ти",
            4 => "4-ти",
            5 => "5-ти",
            6 => "6-ти",
            7 => "7-ми",
            8 => "8-ми",
            _ => $"{floor}-ти"
        };
    }
}
