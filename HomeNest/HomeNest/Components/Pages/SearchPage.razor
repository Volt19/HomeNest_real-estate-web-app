    @* Filter Section *@
    <section class="filter-section">
        <div class="section-container">
            <h1 class="filter-title">Филтрирай бързо и лесно</h1>
            <div class="filter-card ">

            
                <div class="filter-grid">
                    <div class="filter-col">
                        <div class="filter-group">
                            <label class="filter-label">Цена (€)</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       value="@priceFrom"
                                       @oninput="@(e => { priceFrom = e.Value?.ToString() ?? ""; })" />
                                <input type="number" placeholder="до" class="filter-input"
                                       value="@priceTo"
                                       @oninput="@(e => { priceTo = e.Value?.ToString() ?? ""; })" />
                            </div>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Площ (кв.м)</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       value="@areaFrom"
                                       @oninput="@(e => { areaFrom = e.Value?.ToString() ?? ""; })" />
                                <input type="number" placeholder="до" class="filter-input"
                                       value="@areaTo"
                                       @oninput="@(e => { areaTo = e.Value?.ToString() ?? ""; })" />
                            </div>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Етаж</label>
                            <div class="filter-inputs">
                                <input type="number" placeholder="от" class="filter-input"
                                       value="@floorFrom"
                                       @oninput="@(e => { floorFrom = e.Value?.ToString() ?? ""; })" />
                                <input type="number" placeholder="до" class="filter-input"
                                       value="@floorTo"
                                       @oninput="@(e => { floorTo = e.Value?.ToString() ?? ""; })" />
                            </div>
                        </div>
                    </div>
                    <div class="filter-col">
                        <div class="filter-group">
                            <label class="filter-label">Район</label>
                            <select class="filter-select" value="@selectedDistrict" @onchange="@(e => { selectedDistrict = e.Value?.ToString() ?? "Всички"; })">
                                @foreach (var district in districts)
                                {
                                    <option value="@district">@district</option>
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Вид на имота</label>
                            <select class="filter-select" value="@selectedType" @onchange="@(e => { selectedType = e.Value?.ToString() ?? "Всички"; })">
                                @foreach (var type in propertyTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Сортиране</label>
                            <select class="filter-select" value="@sortBy" @onchange="@(e => { sortBy = e.Value?.ToString() ?? "default"; })">
                                @foreach (var opt in sortOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="filter-cta" style="display: flex; gap: 16px; justify-content: center; margin-top: 32px;">
                    @if (HasActiveFilters)
                    {
                        <button class="btn-pill btn-pill-outline" @onclick="ClearFilters">Изчисти филтрите</button>
                    }
                    <button class="btn-search-primary">
                        <span>Показани @FilteredProperties.Count() имота</span>
                        @if (IsFiltering)
                        {
                            <span class="filter-spinner"></span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </section>

    @* Active Filters Chips *@
    @if (HasActiveFilters)
    {
        <section class="active-filters-section">
            <div class="section-container">
                <div class="active-filters">
                    @if (!string.IsNullOrEmpty(priceFrom) || !string.IsNullOrEmpty(priceTo))
                    {
                        <span class="filter-chip">
                            Цена: @(string.IsNullOrEmpty(priceFrom) ? "0" : priceFrom) - @(string.IsNullOrEmpty(priceTo) ? "∞" : priceTo) €
                            <button @onclick="@(() => { priceFrom = ""; priceTo = ""; })">×</button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(areaFrom) || !string.IsNullOrEmpty(areaTo))
                    {
                        <span class="filter-chip">
                            Площ: @(string.IsNullOrEmpty(areaFrom) ? "0" : areaFrom) - @(string.IsNullOrEmpty(areaTo) ? "∞" : areaTo) кв.м
                            <button @onclick="@(() => { areaFrom = ""; areaTo = ""; })">×</button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(floorFrom) || !string.IsNullOrEmpty(floorTo))
                    {
                        <span class="filter-chip">
                            Етаж: @(string.IsNullOrEmpty(floorFrom) ? "0" : floorFrom) - @(string.IsNullOrEmpty(floorTo) ? "∞" : floorTo)
                            <button @onclick="@(() => { floorFrom = ""; floorTo = ""; })">×</button>
                        </span>
                    }
                    @if (selectedDistrict != "Всички")
                    {
                        <span class="filter-chip">
                            @selectedDistrict
                            <button @onclick="@(() => selectedDistrict = "Всички")">×</button>
                        </span>
                    }
                    @if (selectedType != "Всички")
                    {
                        <span class="filter-chip">
                            @selectedType
                            <button @onclick="@(() => selectedType = "Всички")">×</button>
                        </span>
                    }
                </div>
            </div>
        </section>
    }

    @* Properties Section *@
    <section class="properties-section">
        <div class="section-container">
            <h2 class="properties-title">Имоти</h2>
            @if (!FilteredProperties.Any())
            {
                <div class="empty-state">
                    <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <p class="empty-title">Няма намерени имоти</p>
                    <p class="empty-subtitle">Опитайте да промените филтрите или изчистете всички</p>
                    <button class="btn-search-primary" @onclick="ClearFilters">Изчисти филтрите</button>
                </div>
            }
            else
            {
                <div class="properties-grid">
                    @foreach (var property in FilteredProperties)
                    {
                        <div class="property-card">
                            <div class="property-image-wrap">
                                <img src="@property.Image" alt="@property.Title" loading="lazy" />
                                <div class="property-badge">@property.Type</div>
                            </div>
                            <div class="property-content">
                                <h3 class="property-title">@property.Title</h3>
                                <p class="property-desc">@property.Description</p>
                                <div class="property-meta">
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5" /></svg>
                                        @property.Area кв.м
                                    </span>
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 20h10M6 4h12a1 1 0 011 1v14a1 1 0 01-1 1H6a1 1 0 01-1-1V5a1 1 0 011-1z" /></svg>
                                        Етаж @property.Floor
                                    </span>
                                    <span class="meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3v18M19 3v18M5 12h14" /></svg>
                                        @property.Rooms @(property.Rooms == 1 ? "стая" : "стаи")
                                    </span>
                                </div>
                                @* <div class="property-features">
                                    @foreach (var feature in property.Features)
                                    {
                                        <div class="property-feature">
                                            <div class="feature-check">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="width: 12px; height: 12px;">
                                                    <polyline points="20 6 9 17 4 12" />
                                                </svg>
                                            </div>
                                            <span>@feature</span>
                                        </div>
                                    }
                                </div> *@
                                <div class="property-footer">
                                    <a href="/property/@property.Id" class="btn-secondary-sm-link">
                                        <button class="btn-secondary-sm">Виж повече</button>
                                    </a>
                                    <div class="property-price">
                                        <span class="price-value">€@property.Price</span>
                                        <span class="price-unit">@property.PriceUnit</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @* Newsletter Section *@
    <section class="newsletter-section">
        <div class="section-container">
            <div class="newsletter-card">
                <div class="newsletter-card-content">
                    <h2>Абонирай се</h2>
                    <p>Lorem ipsum dolor sit amet consectetur. Feugiat ut aliquet sit pellentesque sollicitudin. Egestas faucibus lacus diam in senectus consectetur. Mattis elit adipiscing quisque tellus scelerisque vehicula ante nunc.</p>
                    <div class="newsletter-card-form">
                        <input type="email" placeholder="Въведете имейл" />
                        <button class="btn-submit-rounded">Изпрати</button>
                    </div>
                </div>
                <div class="newsletter-card-image">
                    <img src="images/newsletter-house.png" alt="Къща" />
                </div>
            </div>
        </div>
    </section>
</div>

