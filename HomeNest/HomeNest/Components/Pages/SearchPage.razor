    // ===== Computed Filtered Properties =====
    private IEnumerable<Property> FilteredProperties => GetFilteredAndSortedProperties();

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(priceFrom) ||
        !string.IsNullOrEmpty(priceTo) ||
        !string.IsNullOrEmpty(areaFrom) ||
        !string.IsNullOrEmpty(areaTo) ||
        !string.IsNullOrEmpty(floorFrom) ||
        !string.IsNullOrEmpty(floorTo) ||
        selectedDistrict != "Всички" ||
        selectedType != "Всички" ||
        sortBy != "default";

    private IEnumerable<Property> GetFilteredAndSortedProperties()
    {
        var result = allProperties.AsEnumerable();

        // Price filter
        if (!string.IsNullOrEmpty(priceFrom) && int.TryParse(priceFrom, out var pf))
            result = result.Where(p => p.Price >= pf);

        if (!string.IsNullOrEmpty(priceTo) && int.TryParse(priceTo, out var pt))
            result = result.Where(p => p.Price <= pt);

        // Area filter
        if (!string.IsNullOrEmpty(areaFrom) && int.TryParse(areaFrom, out var af))
            result = result.Where(p => p.Area >= af);

        if (!string.IsNullOrEmpty(areaTo) && int.TryParse(areaTo, out var at))
            result = result.Where(p => p.Area <= at);

        // Floor filter
        if (!string.IsNullOrEmpty(floorFrom) && int.TryParse(floorFrom, out var ff))
            result = result.Where(p => p.Floor >= ff);

        if (!string.IsNullOrEmpty(floorTo) && int.TryParse(floorTo, out var ft))
            result = result.Where(p => p.Floor <= ft);

        // District filter
        if (selectedDistrict != "Всички")
            result = result.Where(p => p.District == selectedDistrict);

        // Type filter
        if (selectedType != "Всички")
            result = result.Where(p => p.Type == selectedType);

        // Sorting
        result = sortBy switch
        {
            "price-asc" => result.OrderBy(p => p.Price),
            "price-desc" => result.OrderByDescending(p => p.Price),
            "area-asc" => result.OrderBy(p => p.Area),
            "area-desc" => result.OrderByDescending(p => p.Area),
            _ => result
        };

        return result.ToList();
    }

    private void ClearFilters()
    {
        priceFrom = "";
        priceTo = "";
        areaFrom = "";
        areaTo = "";
        floorFrom = "";
        floorTo = "";
        selectedDistrict = "Всички";
        selectedType = "Всички";
        sortBy = "default";
    }
}

